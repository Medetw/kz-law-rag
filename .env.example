# LLM for the agent (/ask, kzlaw ask, answer evals). OpenAI-compatible endpoints.
LLM_PROVIDER=deepseek            # deepseek | anthropic
# LLM_MODEL=                     # default: deepseek-flash / claude-haiku-5-5
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# Langfuse tracing (optional; off when keys are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or LANGFUSE_HOST; EU region

# Retrieval
# EMBEDDING_BACKEND=onnx         # onnx (default, no torch) | e5 (sentence-transformers) | hash (tests)
# RERANK=false                   # cross-encoder second stage; needs `uv sync --group ml` and ~1 GB more RAM
